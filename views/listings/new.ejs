<% layout ("/layouts/boilerplate") %>
<div class="row">
  <div class="col-8 offset-2">
    <br/><br/>
    <h3>Create New Listing</h3>
    <form action="/listings" method="POST" novalidate class="needs-validation">
      <div class="mb-3">
        <label for="title" class="form-level">Title</label>
        <input
          name="listing[title]" 
          placeholder=" enter Title"
          type="text"
          class="form-control" required/>
          <div class="valid-feedback">
            Looks good!
          </div>
       </div>

       <div class="mb-3">
        <label for="description" class="form-level">Description</label>
        <textarea 
            name="listing[description]" 
            class="form-control">
        </textarea>
        <div class="invalid-feedback">
            Please provide a valid description.
          </div>
       </div>

       <div class="mb-3">
        <label for="image" class="form-level">Image link</label>
        <input name="listing[image]" placeholder=" enter Image URL/link" type="text" class="form-control"/>
       </div>

       <div class="mb-3 col-md-4">
        <label for="price" class="form-level">Price</label>
        <input name="listing[price]" placeholder=" enter Price"  class="form-control" required/>
        <div class="invalid-feedback">
            Please provide a valid price.
          </div>
       </div>

       <div class="mb-3">
        <label for="location" class="form-level">Location</label>
        <input name="listing[location]" placeholder=" enter Location" type="text" class="form-control" required/>
        <div class="invalid-feedback">
            Please provide a valid location.
          </div>
       </div>

       <div class="mb-3 col-md-7">
        <label for="country" class="form-level">Country</label>
        <input name="listing[country]" placeholder=" enter Country" type="text" class="form-control" required/>
        <div class="invalid-feedback">
            Please provide a valid country.
          </div>
       </div>
        <br/><br/>
        <button class="btn btn-dark add-btn">Add</button>
        <br/><br/>
    </form>
  </div>
</div>